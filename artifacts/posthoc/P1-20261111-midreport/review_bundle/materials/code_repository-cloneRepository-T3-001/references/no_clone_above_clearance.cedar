permit (principal is User, action == Action::"cloneRepository", resource is Repository)
when { !((principal.roles.contains(Role::"developer") || principal.roles.contains(Role::"reviewer") || principal.roles.contains(Role::"maintainer") || principal.roles.contains(Role::"securityLead")) && ((principal.clearanceLevel == ClearanceLevel::"public" && (resource.sensitivityClassification == ClearanceLevel::"internal" || resource.sensitivityClassification == ClearanceLevel::"confidential" || resource.sensitivityClassification == ClearanceLevel::"restricted")) || (principal.clearanceLevel == ClearanceLevel::"internal" && (resource.sensitivityClassification == ClearanceLevel::"confidential" || resource.sensitivityClassification == ClearanceLevel::"restricted")) || (principal.clearanceLevel == ClearanceLevel::"confidential" && resource.sensitivityClassification == ClearanceLevel::"restricted"))) };