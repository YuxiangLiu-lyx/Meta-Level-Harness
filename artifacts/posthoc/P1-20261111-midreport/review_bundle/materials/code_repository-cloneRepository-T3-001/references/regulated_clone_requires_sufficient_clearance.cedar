permit (principal is User, action == Action::"cloneRepository", resource is Repository)
when { !(resource.topicTags.contains("regulated-data") && ((principal.clearanceLevel == ClearanceLevel::"public" && (resource.sensitivityClassification == ClearanceLevel::"internal" || resource.sensitivityClassification == ClearanceLevel::"confidential" || resource.sensitivityClassification == ClearanceLevel::"restricted")) || (principal.clearanceLevel == ClearanceLevel::"internal" && (resource.sensitivityClassification == ClearanceLevel::"confidential" || resource.sensitivityClassification == ClearanceLevel::"restricted")) || (principal.clearanceLevel == ClearanceLevel::"confidential" && resource.sensitivityClassification == ClearanceLevel::"restricted"))) };