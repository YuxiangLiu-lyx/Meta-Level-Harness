permit (principal is User, action == Action::"readNamespaceSecret", resource is NamespaceSecret)
when { !(((principal is User) && (!(resource has ownerUser) || ((resource has ownerUser) && resource.ownerUser != principal))) || ((principal is ServiceAccount) && (!(resource has ownerServiceAccount) || ((resource has ownerServiceAccount) && resource.ownerServiceAccount != principal)))) };