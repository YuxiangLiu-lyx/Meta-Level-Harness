permit (principal is User, action == Action::"approveDeployment", resource is Deployment) when { (principal.isCommitter && principal.isApprover) || (principal.isApprover && principal.isReleaseManager) || (principal.isApprover && principal != resource.committer && (resource.changeRisk <= context.extraScrutinyThreshold || resource.submittedForReview)) || (principal.isReleaseManager && principal != resource.committer && (resource.changeRisk <= context.extraScrutinyThreshold || resource.submittedForReview)) };