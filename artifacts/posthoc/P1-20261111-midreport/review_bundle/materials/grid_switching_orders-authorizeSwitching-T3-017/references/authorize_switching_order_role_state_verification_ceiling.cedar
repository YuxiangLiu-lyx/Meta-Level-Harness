permit (principal is User, action == Action::"authorizeSwitchingOrder", resource is SwitchingOrder) when { resource.status == "planned" && context.lockoutTagoutVerified && ((context.voltageAboveShiftSupervisorThreshold && principal.roles.contains(Role::"ShiftSupervisor")) || (!context.voltageAboveShiftSupervisorThreshold && (principal.roles.contains(Role::"Planner") || principal.roles.contains(Role::"ShiftSupervisor")))) };