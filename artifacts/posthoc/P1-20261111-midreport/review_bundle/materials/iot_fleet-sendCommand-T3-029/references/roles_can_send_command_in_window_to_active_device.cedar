permit (principal is User, action == Action::"sendCommand", resource is Command) when {
    ((principal.roles.contains(Role::"operator") || principal.roles.contains(Role::"technician") || principal.roles.contains(Role::"fleetAdmin")) && context.maintenanceWindow.permitted && context.currentTime >= context.maintenanceWindow.startTime && context.currentTime <= context.maintenanceWindow.endTime && resource.targetDevice.status == DeviceStatus::"active")
    && !((principal.roles.contains(Role::"operator") || principal.roles.contains(Role::"technician") || principal.roles.contains(Role::"fleetAdmin")) && resource.targetDevice.owner != principal && (resource.targetDevice.status == DeviceStatus::"provisioned" || resource.targetDevice.status == DeviceStatus::"decommissioned"))
};